{
  "name": "html-ppt-gen",
  "version": "1.0.0",
  "description": "Generate professional HTML presentations with automated tooling",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "generate-image": "node dist/generate_image.js",
    "screenshot": "node dist/screenshot_html.js",
    "verify": "node dist/verify_layout.js",
    "deploy": "node dist/deploy_presentation.js",
    "generate-image:dev": "bun scripts/generate_image.ts",
